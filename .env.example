PROMETHEUS_DATABASE_URL=sqlite:///./backend/data/prometheus.db
PROMETHEUS_OBJECT_STORE=./backend/data/objects
PROMETHEUS_SEED_DEMO=true
PROMETHEUS_CORS_ORIGINS=http://localhost:5173

# PostgreSQL production/local-compose option:
# PROMETHEUS_DATABASE_URL=postgresql+psycopg://prometheus:prometheus@localhost:5432/prometheus

# Optional OpenAI-compatible embedding service. Literal loopback HTTP only.
# PROMETHEUS_LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# PROMETHEUS_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# PROMETHEUS_LOCAL_EMBEDDING_REVISION=<pinned-model-revision>

# Optional typed dependency/NER/coreference/SRL service. Literal loopback HTTP only.
# PROMETHEUS_LOCAL_LINGUISTIC_BASE_URL=http://127.0.0.1:8081/v1
# PROMETHEUS_LOCAL_LINGUISTIC_MODEL=<local-parser-model>
# PROMETHEUS_LOCAL_LINGUISTIC_REVISION=<pinned-model-revision>
