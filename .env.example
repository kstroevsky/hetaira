PROMETHEUS_DATABASE_URL=sqlite:///./backend/data/prometheus.db
PROMETHEUS_OBJECT_STORE=./backend/data/objects
PROMETHEUS_SEED_DEMO=true
PROMETHEUS_CORS_ORIGINS=http://localhost:5173

